# Deployment configuration
# Copy this file to .env.deploy and update with your settings

# ============================================
# Raspberry Pi Configuration (deploy_to_pi.sh)
# ============================================
PI_USER=pi
PI_HOST=raspberrypi.local
# PI_HOST=192.168.1.100  # Or use IP address if .local doesn't work
PI_PATH=/home/pi/H.E.N.R.Y.

# Password automation (requires sshpass: sudo apt install sshpass)
# WARNING: Storing passwords in plaintext is insecure!
# Use SSH keys instead when possible.
# PI_PASSWORD=your_pi_password

# ============================================
# Server Configuration (deploy_to_server.sh)
# ============================================
SERVER_USER=name
SERVER_HOST=path
SERVER_PATH=/home/name/H.E.N.R.Y.

# Password automation (requires sshpass: sudo apt install sshpass)
# WARNING: Storing passwords in plaintext is insecure!
# Use SSH keys instead when possible.
SERVER_PASSWORD=password
