[Unit]
Description=H.E.N.R.Y. Backend Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/H.E.N.R.Y.
Environment="PATH=/home/pi/H.E.N.R.Y/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/H.E.N.R.Y/.venv/bin/uvicorn backend.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


