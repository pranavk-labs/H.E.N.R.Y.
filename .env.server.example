# H.E.N.R.Y. Server Environment Configuration
# Copy this file to .env.server and update with your server settings

# ============================================================================
# Application Configuration
# ============================================================================

# Application environment: "development" or "production"
APP_ENV=production

# Enable debug mode (True/False)
DEBUG=False

# API server host (0.0.0.0 for Docker, 127.0.0.1 for local)
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# ============================================================================
# Neo4j Database Configuration
# ============================================================================

# Neo4j connection URI
# Local: bolt://localhost:7687
# Docker network: bolt://neo4j:7687
# Remote: bolt://your-neo4j-host:7687
NEO4J_URI=bolt://localhost:7687

# Neo4j username
NEO4J_USER=neo4j

# Neo4j password
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================================
# Ollama LLM Configuration
# ============================================================================

# Ollama base URL
# Local: http://localhost:11434
# Docker network: http://ollama:11434
# Remote (via Tailscale): http://your-server-ip:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use
OLLAMA_MODEL=qwen2.5:7b-instruct

# ============================================================================
# STT Configuration (Speech-to-Text) - SERVER SIDE
# ============================================================================

# STT engine for server (use "whisper" to run OpenAI Whisper locally)
STT_ENGINE=whisper

# Whisper model size: "tiny", "base", "small" (recommended), "medium", "large"
# small: 500MB, good accuracy, balanced speed
# medium: 1.5GB, better accuracy, slower
WHISPER_MODEL_SIZE=small

# ============================================================================
# Audio Configuration (Not needed on server, but kept for compatibility)
# ============================================================================

# Audio should be disabled on server (only Pi needs audio)
AUDIO_ENABLED=False

# ============================================================================
# GUI Configuration (Not needed on server)
# ============================================================================

# These are only used by the Pi GUI, but included for completeness
GUI_HAPPY_DURATION=120
GUI_NEUTRAL_DURATION=300
GUI_SLEEPY_DURATION=600
