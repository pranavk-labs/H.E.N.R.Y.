# H.E.N.R.Y. Environment Configuration Example
# Copy this file to .env.local for local development or .env.pi for Raspberry Pi production

# ============================================================================
# Application Configuration
# ============================================================================

# Application environment: "development" or "production"
APP_ENV=development

# Enable debug mode (True/False)
DEBUG=True

# API server host (127.0.0.1 for local, 0.0.0.0 for network access)
API_HOST=127.0.0.1

# API server port
API_PORT=8000

# ============================================================================
# Neo4j Database Configuration
# ============================================================================

# Neo4j connection URI
# Local: bolt://localhost:7687
# Remote (via Tailscale): bolt://your-server-ip:7687
NEO4J_URI=bolt://localhost:7687

# Neo4j username
NEO4J_USER=neo4j

# Neo4j password (leave empty if no password set)
NEO4J_PASSWORD=henry123

# ============================================================================
# Ollama LLM Configuration
# ============================================================================

# Ollama base URL
# Local: http://localhost:11434
# Remote (via Tailscale): http://your-server-ip:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Audio Configuration
# ============================================================================

# Enable audio/wake word detection (True/False)
# Set to False for local development without audio hardware
AUDIO_ENABLED=False

# Wake word phrase that triggers HENRY
WAKE_WORD="Hey HENRY"

# Wake word cooldown (seconds) - prevents multiple triggers from single utterance
# Default: 3.0 seconds
WAKE_WORD_COOLDOWN=3.0

# ============================================================================
# GUI Personality Configuration
# ============================================================================

# Emotional state timing thresholds (in seconds)
# These control how long HENRY stays in each emotional state before becoming "sleepy"
# Longer times = more patient HENRY, shorter times = faster testing

# Time before transitioning from happy to neutral (default: 120 seconds = 2 minutes)
# For fast testing, try: 10
GUI_HAPPY_DURATION=120

# Time before transitioning from neutral to sleepy (default: 300 seconds = 5 minutes)
# For fast testing, try: 30
GUI_NEUTRAL_DURATION=300

# Time before transitioning from sleepy to very sleepy/asleep (default: 600 seconds = 10 minutes)
# For fast testing, try: 60
GUI_SLEEPY_DURATION=600
