# H.E.N.R.Y. Environment Configuration Example
# Copy this file to .env.local for local development or .env.pi for Raspberry Pi production

# ============================================================================
# Application Configuration
# ============================================================================

# Application environment: "development" or "production"
APP_ENV=development

# Enable debug mode (True/False)
DEBUG=True

# API server host (127.0.0.1 for local, 0.0.0.0 for network access)
API_HOST=127.0.0.1

# API server port
API_PORT=8000

# ============================================================================
# Neo4j Database Configuration
# ============================================================================

# Neo4j connection URI
# Local: bolt://localhost:7687
# Remote (via Tailscale): bolt://your-server-ip:7687
NEO4J_URI=bolt://localhost:7687

# Neo4j username
NEO4J_USER=neo4j

# Neo4j password (leave empty if no password set)
NEO4J_PASSWORD=

# ============================================================================
# Ollama LLM Configuration
# ============================================================================

# Ollama base URL
# Local: http://localhost:11434
# Remote (via Tailscale): http://your-server-ip:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Audio Configuration
# ============================================================================

# Enable audio/wake word detection (True/False)
# Set to False for local development without audio hardware
AUDIO_ENABLED=False

# Wake word phrase that triggers HENRY
WAKE_WORD="Hey HENRY"
