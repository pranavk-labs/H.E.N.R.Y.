# H.E.N.R.Y. Raspberry Pi Environment Configuration
# Copy this file to .env.pi and update with your settings

# ============================================================================
# Application Configuration
# ============================================================================

# Application environment: "production" for Pi
APP_ENV=production

# Enable debug mode (True/False)
DEBUG=False

# Backend API URL (connects to home server via Tailscale)
# The voice loop on Pi sends requests to this API
API_BASE_URL=http://your-server-tailscale-ip:8000

# ============================================================================
# Neo4j Database Configuration (Remote Server via Tailscale)
# ============================================================================

# Neo4j connection URI - Point to your home server via Tailscale
NEO4J_URI=bolt://your-server-tailscale-ip:7687

# Neo4j username
NEO4J_USER=neo4j

# Neo4j password
NEO4J_PASSWORD=henry123

# ============================================================================
# Ollama LLM Configuration (Remote Server via Tailscale)
# ============================================================================

# Ollama base URL - Point to your home server via Tailscale
OLLAMA_BASE_URL=http://your-server-tailscale-ip:11434

# ============================================================================
# Audio Configuration (ENABLED for Raspberry Pi)
# ============================================================================

# Enable audio/wake word detection (True for Pi with audio hardware)
AUDIO_ENABLED=True

# Wake word phrase that triggers HENRY
WAKE_WORD="Hey HENRY"

# Wake word cooldown (seconds) - prevents multiple triggers from single utterance
WAKE_WORD_COOLDOWN=3.0

# ============================================================================
# GUI Personality Configuration
# ============================================================================

# Emotional state timing thresholds (in seconds)
GUI_HAPPY_DURATION=120
GUI_NEUTRAL_DURATION=300
GUI_SLEEPY_DURATION=600
